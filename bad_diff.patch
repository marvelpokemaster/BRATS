+    "def load_nii(path):    return nib.load(path).get_fdata().astype(np.float32)def normalize_brain(vol):    mask = vol > 0    out = np.zeros_like(vol, dtype=np.float32)    if mask.any():        vals = vol[mask]        out[mask] = (vals - vals.mean()) / (vals.std() + 1e-08)    return outCLASS_NAMES = ['BG', 'NCR/NET', 'ED', 'ET']NUM_CLASSES = 4def remap_labels(seg):    out = np.zeros(seg.shape, dtype=np.uint8)    out[seg == 1] = 1  # BraTS raw labels 0/1/2/4 -> 0/1/2/3    out[seg == 2] = 2    out[seg == 4] = 3    return outdef load_case(files):    vols = {m: load_nii(files[m]) for m in MODALITIES}    brain = np.zeros(vols['t1'].shape, dtype=bool)    for m in MODALITIES:        brain = brain | (vols[m] > 0)    vols = {m: normalize_brain(v) for m, v in vols.items()}    seg = remap_labels(load_nii(files['seg']).round().astype(np.int64))    return (vols, seg, brain)def crop_bounds(brain):    coords = np.argwhere(brain)    return (coords.min(axis=0), coords.max(axis=0) + 1)def crop(vol, lo, hi):    return vol[lo[0]:hi[0], lo[1]:hi[1], lo[2]:hi[2]]def dice_binary(pred, target, eps=1e-06):    pred = pred.astype(bool)    target = target.astype(bool)    inter = np.logical_and(pred, target).sum()    return float((2 * inter + eps) / (pred.sum() + target.sum() + eps))def _binary_surface(mask):    from scipy.ndimage import binary_erosion    mask = np.asarray(mask, dtype=bool)    if not mask.any():        return np.zeros_like(mask, dtype=bool)    return mask & ~binary_erosion(mask, structure=np.ones((3, 3, 3), dtype=bool), border_value=0)def _binary_region_metrics(pred, target):    from scipy.ndimage import distance_transform_edt    pred, target = np.asarray(pred, dtype=bool), np.asarray(target, dtype=bool)    tp = int(np.logical_and(pred, target).sum())    fp = int(np.logical_and(pred, ~target).sum())    fn = int(np.logical_and(~pred, target).sum())    ps, ts = int(pred.sum()), int(target.sum())    dice = (2.0 * tp / (ps + ts)) if (ps + ts) else 1.0    iou = (tp / (tp + fp + fn)) if (tp + fp + fn) else 1.0    precision = (tp / ps) if ps else (1.0 if ts == 0 else 0.0)    recall = (tp / ts) if ts else 1.0    if not pred.any() or not target.any():        hd95 = float(\"nan\")    else:        pred_surface, target_surface = _binary_surface(pred), _binary_surface(target)        d_to_target = distance_transform_edt(~target_surface)        d_to_pred = distance_transform_edt(~pred_surface)        distances = np.concatenate((d_to_target[pred_surface], d_to_pred[target_surface]))        hd95 = float(np.percentile(distances, 95))  # voxel units; spacing not supplied    return {\"Dice\": float(dice), \"HD95\": hd95, \"Sensitivity\": float(recall),            \"Precision\": float(precision), \"IoU\": float(iou)}def segmentation_metrics(pred, target):    regions = {        \"WT\": (pred > 0, target > 0),        \"TC\": (np.logical_or(pred == 1, pred == 3), np.logical_or(target == 1, target == 3)),        \"ET\": (pred == 3, target == 3),    }    out = {}    for region, (p, t) in regions.items():        for metric, value in _binary_region_metrics(p, t).items():            out[f\"{metric}_{region}\"] = value    return outdef postprocess_prediction(pred, et_min_voxels=ET_MIN_VOXELS):    \"\"\"Standard BraTS trick: a tiny predicted ET is almost always a false positive    (LGG cases often have no ET). Relabel it as NCR/NET so TC is preserved.\"\"\"    et = pred == 3    n_et = int(et.sum())    if 0 < n_et < et_min_voxels:        pred = pred.copy()        pred[et] = 1    return preddef fmt_metrics(m):    return f\"WT={m['Dice_WT']:.4f} | TC={m['Dice_TC']:.4f} | ET={m['Dice_ET']:.4f}\"def tumour_crop_bounds(seg_c, margin=VOXEL_MARGIN, max_size=VOXEL_MAX_SIZE):    \"\"\"Crop to the tumour bounding box + margin for the voxel refinement head.    Returns (lo, hi) in the cropped-brain coordinate system, or (None, None) if    the case has no tumour. If the crop exceeds max_size, it is centred and    truncated to keep the U-Net memory-bounded.    \"\"\"# ============================================================# Voxel refinement helpers    coords = np.argwhere(seg_c > 0)    if len(coords) == 0:        return (None, None)    lo = np.maximum(coords.min(axis=0) - margin, 0)    hi = np.minimum(coords.max(axis=0) + margin + 1, np.asarray(seg_c.shape))    sz = hi - lo    for ax in range(3):        if sz[ax] > max_size:            ctr = (lo[ax] + hi[ax]) // 2            lo[ax] = max(0, ctr - max_size // 2)            hi[ax] = lo[ax] + max_size    return (lo, hi)def project_node_probs_cropped(node_probs, meta):  # Clamp to max_size (centred on the tumour)    \"\"\"Return (X, Y, Z, NUM_CLASSES) probability maps in the cropped brain region.\"\"\"    crop_shape = tuple(meta['crop_shape'])    acc = np.zeros(crop_shape + (NUM_CLASSES,), dtype=np.float32)    count = np.zeros(crop_shape, dtype=np.float32)    for nt, probs in node_probs.items():        nm = meta['node_map'][nt]        valid = nm >= 0        acc[valid] = acc[valid] + np.asarray(probs, dtype=np.float32)[nm[valid]]        count[valid] = count[valid] + 1.0    valid = count > 0    acc[valid] = acc[valid] / count[valid, None]    return accdef postprocess_prediction_cc(pred, et_min_voxels=ET_MIN_VOXELS):    \"\"\"Connected-component post-processing: remove small ET islands individually.    More precise than the global-volume-threshold approach: a large total ET    volume with one big island and several tiny false-positive islands will    keep the big island and remove only the spurious ones.    \"\"\"    from scipy.ndimage import label as _cc_label    pred = pred.copy()    et = pred == 3    if et.any():        labeled, n_cc = _cc_label(et)        for _i in range(1, n_cc + 1):            comp = labeled == _i            if int(comp.sum()) < et_min_voxels:                pred[comp] = 1    return preddef postprocess_prediction_auto(pred, et_min_voxels=ET_MIN_VOXELS):    \"\"\"Use connected-component post-processing when enabled, else the original.\"\"\"    if USE_CC_POSTPROCESS:        return postprocess_prediction_cc(pred, et_min_voxels)    return postprocess_prediction(pred, et_min_voxels)def load_meta(mpath):    return torch.load(mpath, weights_only=False)  # relabel as NCR/NET (preserves TC)"
