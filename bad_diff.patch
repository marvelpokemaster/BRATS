a['seg'])  # the cached cropped tensors (GPU-only, no reconstruct/postprocess).        _m_v = segmentation_metrics(_pred_v, _meta['seg'])  # NOTE: this is not the final reported metric -- evaluate_items_voxel        rows['graph'].append(_m_g)  # below still runs the real full-volume, post-processed evaluation        rows['voxel'].append(_m_v)  # once, at the end, exactly as the original cell did. Assumption:        _delta_et = _m_v['Dice_ET'] - _m_g['Dice_ET']  # cropped-region Dice tracks full-volume post-processed Dice closely        print(f'{name} {_i + 1:02d}: graph {fmt_metrics(_m_g)} | voxel {fmt_metrics(_m_v)}  ET delta {_delta_et:+.4f}')  # enough for epoch-to-epoch model selection; if that turns out not to    summary = {}    for _kind, _rs in rows.items():        _keys = _rs[0].keys() if _rs else []        summary[_kind] = {k: float(np.nanmean([r[k] for r in _rs]))                          if _rs and np.isfinite([r[k] for r in _rs]).any() else float(\"nan\")                          for k in _keys}        summary[_kind][\"std\"] = {k: float(np.nanstd([r[k] for r in _rs]))                                 if _rs and np.isfinite([r[k] for r in _rs]).any() else float(\"nan\")                                 for k in _keys}    for _kind, _label in ((\"graph\", \"graph-only\"), (\"voxel\", \"+voxel\")):        print(f\"\\n{name} {_label} metrics (patient mean ± SD):\")        for _region in (\"WT\", \"TC\", \"ET\"):            _parts = []            for _metric in (\"Dice\", \"HD95\", \"Sensitivity\", \"Precision\", \"IoU\"):                _key = _metric + \"_\" + _region                _mean, _std = summary[_kind][_key], summary[_kind][\"std\"][_key]                _parts.append(f\"{_metric}={_mean:.4f} ± {_std:.4f}\" if np.isfinite(_mean)                              else f\"{_metric}=n/a (undefined for one or more cases)\")            print(\"  \" + _region + \": \" + \" | \".join(_parts))    _d_wt = summary['voxel']['Dice_WT'] - summary['graph']['Dice_WT']    _d_tc = summary['voxel']['Dice_TC'] - summary['graph']['Dice_TC']    _d_et = summary['voxel']['Dice_ET'] - summary['graph']['Dice_ET']    print(f'{name} mean Dice delta (+voxel - graph): WT {_d_wt:+.4f}  TC {_d_tc:+.4f}  ET {_d_et:+.4f}')    return summaryif USE_VOXEL_REFINEMENT:    voxel_head = VoxelRefinementHead(in_channels=len(MODALITIES) + NUM_CLASSES, num_classes=NUM_CLASSES, base_channels=VOXEL_BASE_CHANNELS).to(device)    voxel_optimizer = torch.optim.AdamW(voxel_head.parameters(), lr=VOXEL_LR, weight_decay=WEIGHT_DECAY)    voxel_scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(voxel_optimizer, T_max=VOXEL_EPOCHS, eta_min=VOXEL_LR * 0.02)    voxel_scaler = torch.amp.GradScaler('cuda', enabled=USE_AMP)    model.eval()    for _p in model.parameters():        _p.requires_grad = False    if rec_module is not None:        rec_module.eval()        for _p in rec_module.parameters():            _p.requires_grad = False    _vox_params = sum((p.numel() for p in voxel_head.parameters())) / 1000000.0    print(f'Voxel refinement head: {_vox_params:.2f} M params')    print(f'Training for {VOXEL_EPOCHS} epochs (graph model frozen)...')  # Freeze the graph model -- Stage 2 trains ONLY the voxel head    print(f'  Input: {len(MODALITIES)} MRI + {NUM_CLASSES} node probs = {len(MODALITIES) + NUM_CLASSES} channels')    print(f'  Loss: {VOXEL_DICE_WEIGHT} Dice + {VOXEL_CE_WEIGHT} CE + {VOXEL_FOCAL_WEIGHT} Focal(gamma={VOXEL_FOCAL_GAMMA}) + {VOXEL_BOUNDARY_WEIGHT} Boundary-BCE')    print('[Voxel cache] Computing frozen node-probability maps (GPU, one pass per case)...')    _t0 = time.time()    _node_probs_cache = {}    for _data, _mpath in train_items + val_items:        with torch.no_grad():            _node_probs_cache[_mpath] = predict_node_probs(model, _data)    print(f'[Voxel cache] Node-prob pass done in {(time.time() - _t0) / 60:.1f} min ({len(_node_probs_cache)} cases).')    def _prep_voxel_case(mpath, node_probs):        \"\"\"Pure CPU/numpy work (disk load + SLIC-grid projection + cropping) --        none of it touches the model, so it's safe to run in a worker process.\"\"\"        meta = load_meta(mpath)        probs_c = project_node_probs_cropped(node_probs, meta)  # ---- Step A: one GPU forward pass per case for the frozen node probs ----        mri_c = np.stack([meta['vis'][m].astype(np.float32) for m in MODALITIES])  # Sequential (one CUDA context) but cheap -- exactly what the original        seg_c = crop(meta['seg'], meta['lo'], meta['hi'])  # code did anyway, just done ONCE instead of once per epoch.        tlo, thi = tumour_crop_bounds(seg_c)        if tlo is None:            return None  # mpath -> node_probs (numpy, off-GPU immediately)        x = np.concatenate([mri_c[:, tlo[0]:thi[0], tlo[1]:thi[1], tlo[2]:thi[2]], probs_c.transpose(3, 0, 1, 2)[:, tlo[0]:thi[0], tlo[1]:thi[1], tlo[2]:thi[2]]], axis=0).astype(np.float32)        seg_t = seg_c[tlo[0]:thi[0], tlo[1]:thi[1], tlo[2]:thi[2]].astype(np.int64)        return (x, seg_t)    print(f'[Voxel cache] Building input/target tensors with {NUM_CPU_WORKERS} CPU workers...')    _t0 = time.time()    _train_paths = [m for _, m in train_items]    _val_paths = [m for _, m in val_items]  # ---- Step B: CPU-bound per-case prep, parallel across NUM_CPU_WORKERS ----    _train_prepped = Parallel(n_jobs=NUM_CPU_WORKERS, backend='loky', verbose=5)((delayed(_prep_voxel_case)(m, _node_probs_cache[m]) for m in _train_paths))    _val_prepped = Parallel(n_jobs=NUM_CPU_WORKERS, backend='loky', verbose=5)((delayed(_prep_voxel_case)(m, _node_probs_cache[m]) for m in _val_paths))    print(f'[Voxel cache] Prep done in {(time.time() - _t0) / 60:.1f} min.')    def _to_tensor(arr):        t = torch.from_numpy(arr).unsqueeze(0)        return t    train_cache = [(_to_tensor(x).half(), _to_tensor(y).to(torch.uint8)) for r in _train_prepped if r is not None for x, y in [r]]    val_cache = [(_to_tensor(x).half(), _to_tensor(y).to(torch.uint8)) for r in _val_prepped if r is not None for x, y in [r]]    print(f'[Voxel cache] Usable cases: train={len(train_cache)}/{len(_train_paths)}  val={len(val_cache)}/{len(_val_paths)}')    best_vox_dice = -1.0    best_vox_state = None    best_vox_epoch = 0    vox_epochs_since_improve = 0    vox_history = []    voxel_scaler = torch.amp.GradScaler(\"cuda\", enabled=USE_AMP)    def stage2_state(epoch, training_complete):        return {            \"stage\": \"2-latest\", \"epoch\": epoch, \"epochs_total\": VOXEL_EPOCHS,            \"config_hash\": CONFIG_HASH, \"split\": SPLIT_CASE_IDS,            \"split_fingerprint\": SPLIT_FINGERPRINT,            \"stage2_config\": RUN_CONFIG[\"voxel\"],            \"voxel_state_dict\": {k: v.detach().cpu() for k, v in voxel_head.state_dict().items()},            \"optimizer_state_dict\": voxel_optimizer.state_dict(),            \"scheduler_state_dict\": voxel_scheduler.state_dict(),            \"scaler_state_dict\": voxel_scaler.state_dict(),            \"rng\": {\"torch\": torch.get_rng_state(),                    \"cuda\": torch.cuda.get_rng_state_all() if torch.cuda.is_available() else None,                    \"numpy\": np.random.get_state(), \"python\": random.getstate()},            \"vox_history\": vox_history, \"best_vox_dice\": best_vox_dice,            \"best_vox_state\": best_vox_state, \"best_vox_epoch\": best_vox_epoch,            \"vox_epochs_since_improve\": vox_epochs_since_improve,            \"training_complete\": training_complete,        }    def save_and_push_stage2_latest(epoch, training_complete):        torch.save(stage2_state(epoch, training_complete), STAGE2_LATEST_PATH + \".tmp\")        os.replace(STAGE2_LATEST_PATH + \".tmp\", STAGE2_LATEST_PATH)        if HF_ENABLED:            hf_upload_file_verified(STAGE2_LATEST_PATH, STAGE2_LATEST_NAME,                                    HF_MODEL_REPO_ID, HF_MODEL_REPO_TYPE,                                    f\"stage2 latest epoch {epoch}\")    _latest = None    _start_epoch = 1    stage2_training_complete = False   